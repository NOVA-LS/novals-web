# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# base de datos local y subidas de usuarios (se respaldan aparte, ver deploy/copia.sh)
# el *.db-wal/*.db-shm son de journal_mode=WAL: sin ellos, faltaría lo escrito
# que aún no se ha volcado al fichero principal.
/data/*.db*
/public/uploads/*
!/public/uploads/.gitkeep
